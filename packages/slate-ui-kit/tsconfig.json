{
	"extends": "@slate/config-typescript/react-library.json",
	"compilerOptions": {
		"rootDir": ".",
		"paths": {
			"@slate/icons": [
				"../slate-icons/src/index.ts"
			],
			"@slate/icons/*": [
				"../slate-icons/src/*"
			],
			"@slate/tokens": [
				"../slate-tokens/src/index.ts"
			],
			"@slate/tokens/*": [
				"../slate-tokens/src/*"
			]
		},
		"outDir": "dist/types",
		"tsBuildInfoFile": "dist/types/.tsbuildinfo"
	},
	"include": [
		"src/**/*",
		"tests/**/*"
	],
	"exclude": [
		"dist",
		"node_modules"
	],
	"references": [
		{
			"path": "../slate-icons"
		},
		{
			"path": "../slate-tokens"
		}
	]
}
