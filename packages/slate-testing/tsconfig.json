{
	"extends": "@slate/config-typescript/react-library.json",
	"compilerOptions": {
		"rootDir": ".",
		"paths": {
			"@slate/ui-kit": [
				"../slate-ui-kit/src/index.ts"
			],
			"@slate/ui-kit/*": [
				"../slate-ui-kit/src/*"
			]
		},
		"outDir": "dist/types",
		"tsBuildInfoFile": "dist/types/.tsbuildinfo"
	},
	"include": [
		"src/**/*",
		"tests/**/*"
	],
	"exclude": [
		"dist",
		"node_modules"
	],
	"references": [
		{
			"path": "../slate-ui-kit"
		}
	]
}
