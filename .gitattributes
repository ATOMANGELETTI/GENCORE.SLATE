# Normalise line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Windows-native scripts must keep CRLF or cmd.exe/PowerShell may misparse them.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Explicit text types
*.rs      text diff=rust
*.ts      text
*.tsx     text
*.js      text
*.json    text
*.jsonc   text
*.toml    text
*.yml     text
*.yaml    text
*.md      text diff=markdown
*.css     text diff=css
*.html    text diff=html
*.sql     text

# Binary — never diff, never normalise
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.icns    binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary
*.zip     binary
*.cab     binary
*.exe     binary
*.dll     binary
*.db      binary
*.sqlite  binary
*.sqlite3 binary

# Generated files: collapse in diffs and exclude from language statistics.
bun.lock          linguist-generated=true -diff
Cargo.lock        linguist-generated=true -diff
AGENTS.md         linguist-generated=true
CLAUDE.md         linguist-generated=true
.cursor/rules/**  linguist-generated=true
.agent/rules/**   linguist-generated=true
.github/copilot-instructions.md   linguist-generated=true
.github/instructions/**           linguist-generated=true

# Keep archives out of exported tarballs.
/.github        export-ignore
/.agents        export-ignore
/tests          export-ignore
/.changeset     export-ignore
