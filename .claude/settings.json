{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"//": "Project settings for Claude Code. Personal overrides belong in .claude/settings.local.json, which is git-ignored.",
	"permissions": {
		"allow": [
			"Bash(bun install)",
			"Bash(bun run:*)",
			"Bash(bun test:*)",
			"Bash(bunx:*)",
			"Bash(moon run:*)",
			"Bash(moon check:*)",
			"Bash(moon query:*)",
			"Bash(moon project:*)",
			"Bash(cargo check:*)",
			"Bash(cargo clippy:*)",
			"Bash(cargo test:*)",
			"Bash(cargo build:*)",
			"Bash(cargo fmt:*)",
			"Bash(cargo tree:*)",
			"Bash(git status)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Read(//**)"
		],
		"deny": [
			"Read(./.env.local)",
			"Read(./**/*.pem)",
			"Read(./**/*.key)",
			"Bash(npm:*)",
			"Bash(npx:*)",
			"Bash(pnpm:*)",
			"Bash(yarn:*)"
		],
		"ask": ["Bash(git push:*)", "Bash(gh pr:*)", "Bash(cargo publish:*)"]
	},
	"env": {
		"SLATE_LOG": "debug"
	},
	"enableAllProjectMcpServers": true
}
