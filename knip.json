{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["scripts/*.ts"],
			"project": ["scripts/**/*.ts"]
		},
		"packages/*": {
			"entry": "gallery/gallery.main.tsx",
			"project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "gallery/**/*.{ts,tsx}"]
		},
		"tauri/*": {
			"entry": ["src/tray/tray.main.tsx"],
			"project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
		}
	},
	"ignoreDependencies": ["@slate/tokens", "tailwindcss"],
	"ignoreBinaries": ["moon", "rustfmt"],
	"ignoreExportsUsedInFile": true,
	"includeEntryExports": false
}
