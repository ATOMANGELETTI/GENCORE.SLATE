# EditorConfig — https://editorconfig.org
# The single source of truth for whitespace. Biome and rustfmt are configured
# to agree with these values; if you change one, change all three.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.{json,jsonc,json5,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
