# ─────────────────────────────────────────────────────────────────────────────
# GENCORE.SLATE — environment template
#
# Copy to `.env.local` (git-ignored) and adjust. Every value here is a
# DEVELOPMENT convenience only: a packaged, portable build derives all of its
# paths from the location of its own executable and reads nothing from the
# environment except the variables the Launcher sets for its child processes.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute path to the portable root used while developing.
# Leave unset to use `<repo>/installDir`.
SLATE_DEV_ROOT=

# Overrides portable-root discovery entirely. The Launcher sets this for every
# app it spawns. Setting it by hand is a debugging tool, not a normal workflow.
# SLATE_INSTALL_DIR=

# Log verbosity: error | warn | info | debug | trace
SLATE_LOG=debug

# Emit logs to the console in addition to appdata/logs/.
SLATE_LOG_CONSOLE=1

# Path to a manually downloaded WebView2 fixed-version .cab archive.
# See docs/webview2.md — Microsoft publishes no stable direct download URL,
# so release builds need this pointed at a local copy.
# SLATE_WEBVIEW2_CAB=C:\path\to\WebView2Runtime.cab
